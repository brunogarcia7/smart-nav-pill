<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema base da Activity antes do Compose assumir. DeviceDefault.DayNight
        existe em todas as versoes suportadas (API 29+) e acompanha o modo
        claro/escuro do sistema. Removemos a action bar para o Compose desenhar
        a propria UI edge-to-edge.
    -->
    <style name="Theme.SmartNavPill" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
